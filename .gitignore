# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files
# Useful .gitignore templates: https://github.com/github/gitignore

# ============================================================
# 依赖与构建产物
# ============================================================
node_modules/
bower_components/
dist/
build/
.cache/
.parcel-cache/
.turbo/

# ============================================================
# 日志文件
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# 环境变量与本地配置
# ============================================================
.env
.env.local
.env.*.local
*.pem
*.key

# ============================================================
# 编辑器 / IDE
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================================
# 操作系统生成的文件
# ============================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ============================================================
# 临时文件
# ============================================================
*.tmp
*.temp
*.bak
*.old
